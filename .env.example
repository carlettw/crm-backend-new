# development | production. production'da standart parol/kalit bilan server ishga tushmaydi.
ENVIRONMENT=development
# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
# "postgresql://" ni "postgresql+asyncpg://" ga almashtiring. Parolda maxsus belgilar bo'lsa URL-kodlang (@ → %40)
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true
# kamida 32 belgili tasodifiy qiymat: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# karta raqamlarini shifrlash kaliti (ixtiyoriy, bo'sh bo'lsa SECRET_KEY dan olinadi).
# DIQQAT: bu kalit (yoki SECRET_KEY) o'zgarsa, saqlangan kartalarni o'qib bo'lmaydi — alohida berib qo'ygan ma'qul.
CARD_ENCRYPTION_KEY=
# tashqi cron uchun kalit (ixtiyoriy). Manzilni super admin «Sozlamalar»da ko'radi.
CRON_SECRET=
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000
FIRST_SUPERADMIN_PHONE=+998900000000
FIRST_SUPERADMIN_USERNAME=superadmin
# kamida 10 belgi, harf va raqam. Birinchi kirishda baribir yangisini qo'yish so'raladi.
FIRST_SUPERADMIN_PASSWORD=
# login: 5 ta noto'g'ri urinishdan keyin 15 daqiqa blok
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Telegram bot (ixtiyoriy). Token @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=
FRONTEND_URL=https://travel-operator.uz
# Lokal sinov uchun: PUBLIC_URL=https://sizning-ngrok-manzilingiz
# Xatolarni kuzatish (ixtiyoriy): sentry.io → project → DSN
SENTRY_DSN=
LOG_LEVEL=INFO
